# RanzzNeko environment variables
#
# These are OPTIONAL. The upstream API credentials are currently hardcoded on
# the server (see lib/nekopoi.ts) so the app runs out-of-the-box. When you are
# ready to move secrets out of source, uncomment these and read them in
# lib/nekopoi.ts via process.env.*
#
# IMPORTANT: never prefix these with NEXT_PUBLIC_ — that would leak them to the
# browser. They must stay server-only.

# NEKO_BASE_URL="https://api.example.com/xxxx/yyyy"
# NEKO_TOKEN="your-token-here"
# NEKO_APP_BUILD_CODE="25301"
# NEKO_APP_SIGNATURE="your-signature-here"
